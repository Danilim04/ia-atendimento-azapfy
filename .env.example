# ==============================================================================
# .env ÚNICO da stack docker (raiz) — alimenta brain + gateway via compose.
#
# Dev local:  cp .env.example .env  e preencha os "troque-aqui".
# Produção:   NÃO editar na VPS — o arquivo inteiro é renderizado pela pipeline
#             (deploy/env/prod.env.tpl + render-env.sh) a partir dos GitHub
#             Secrets e reescrito a cada deploy.
#
# A "fiação" entre containers (BRAIN_BASE_URL, SAC_TOOLS_BASE_URL, DB_PATH,
# PORT) NÃO mora aqui: é environment fixo no docker-compose.yml.
# ==============================================================================

# --- Imagens (produção pina a tag; dev usa o default 'dev' com build) ---------
IMAGE_REPO=azapfy-bot
IMAGE_TAG=dev
# Em produção o deploy grava: COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Cérebro: OpenRouter ------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-troque-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_CLASSIFIER_MODEL=google/gemini-2.5-flash-lite
APP_REFERER=http://localhost:8000
APP_TITLE=Azapfy Suporte IA

# --- Cérebro: tuning ----------------------------------------------------------
LLM_TEMPERATURE=0.2
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
AGENT_MAX_ITERACOES=5
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observabilidade (compartilhado: python aceita INFO, go aceita info) ------
LOG_LEVEL=info

# --- Gateway: Chatwoot --------------------------------------------------------
# Em produção fala com o Chatwoot por DENTRO da rede docker do servidor.
CHATWOOT_BASE_URL=http://localhost:9000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=troque-aqui
# Autenticação do webhook (?token=... na URL cadastrada no Chatwoot)
WEBHOOK_TOKEN=dev-token
WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# --- Gateway: etiquetas / gate ------------------------------------------------
LABEL_BOT=fila-bot
LABEL_HUMANO=fila-humano
CONFIRM_FIELD=email
MAX_TENTATIVAS=3
IDENTITY_TTL=24h

# --- Gateway: Mongo da Azapfy (lookup de usuário) -----------------------------
MONGO_URI=mongodb://troque-aqui
MONGO_DB=azapfy3
MONGO_COLLECTION=users
MONGO_TIMEOUT=8s
BRAIN_TIMEOUT=60s

# --- SAC / chamados (tools de dados) ------------------------------------------
SAC_BASE_URL=https://api3.azapfy.com.br
SAC_PORTAL_URL=https://atendimento.azapfy.com.br
SAC_SERVICE_COD=
SAC_GRUPO_EMP=AZAPERS
SAC_EMPRESA=AZAPERS
SAC_TIMEZONE=America/Sao_Paulo
SAC_API_TOKEN=
SAC_CONFIG_TTL=10m
# Segredo compartilhado cérebro↔gateway (X-Tools-Token) — os DOIS lados leem:
TOOLS_API_TOKEN=troque-aqui
SAC_TOOLS_TOKEN=troque-aqui
SAC_TOOLS_TIMEOUT=30
